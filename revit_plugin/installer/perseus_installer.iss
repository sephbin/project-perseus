[Code]
var
  ServerUrlPage: TInputQueryWizardPage;
  FinalServerUrl: String;

// 1. THIS RUNS WHEN THE INSTALLER STARTS
procedure InitializeWizard;
var
  DefaultUrl: String;
begin
  // Create a custom wizard page right after the "Select Destination" page
  ServerUrlPage := CreateInputQueryPage(wpSelectDir,
    'Server Configuration', 
    'Where should Project Perseus connect?',
    'Please specify the Base URL for your Perseus server.');

  // Add the text input box
  ServerUrlPage.Add('Server Base URL:', False);

  // Read the command line parameter (e.g., /SERVERURL="https://sync.cox.com")
  // If the parameter doesn't exist, it falls back to the default URL provided after the pipe (|)
  DefaultUrl := ExpandConstant('{param:SERVERURL|https://perseus.coxarchitecture.com}');

  // Pre-fill the text box with the result
  ServerUrlPage.Values[0] := DefaultUrl;
end;

// 2. THIS RUNS RIGHT AFTER THE FILES ARE COPIED
procedure CurStepChanged(CurStep: TSetupStep);
var
  ConfigDir: String;
  ConfigFile: String;
  JsonContent: String;
begin
  // We only want to write the config file at the very end of the installation
  if CurStep = ssPostInstall then
  begin
    // Grab whatever value was in the text box (whether typed manually or injected via CLI)
    FinalServerUrl := ServerUrlPage.Values[0];

    // --- DEFINE WHERE YOUR C# CONFIG FILE LIVES ---
    // {userappdata} resolves to C:\Users\Username\AppData\Roaming
    ConfigDir := ExpandConstant('{userappdata}\Project Perseus');
    ConfigFile := ConfigDir + '\config.json';

    // Create the folder if it doesn't exist yet
    if not DirExists(ConfigDir) then
      CreateDir(ConfigDir);

    // Build the JSON string to match what your C# Config.Instance expects
    // Note: Pascal uses #13#10 for line breaks
    JsonContent := '{' + #13#10 +
                   '  "BaseUrl": "' + FinalServerUrl + '"' + #13#10 +
                   '}';

    // Save the text to the config.json file (False = overwrite, do not append)
    SaveStringToFile(ConfigFile, JsonContent, False);
  end;
end;