#endif

[Code]
const
  // Revit versions built into this installer, e.g. '2023,2026,' (see #define Years at the top).
  BuiltYears = '{#Years}';

var
  ServerUrlPage: TInputQueryWizardPage;
  FinalServerUrl: String;

// Revit <year> is on this PC: its program folder, or Autodesk's registry key for it.
function RevitInstalled(Year: String): Boolean;
begin
  Result := DirExists(ExpandConstant('{commonpf64}') + '\Autodesk\Revit ' + Year)
         or RegKeyExists(HKLM64, 'SOFTWARE\Autodesk\Revit\' + Year)
         or RegKeyExists(HKLM64, 'SOFTWARE\Autodesk\Revit\Autodesk Revit ' + Year);
end;

// Perseus is already installed for Revit <year> (an upgrade keeps it).
function PerseusInstalled(Year: String): Boolean;
begin
  Result := FileExists(ExpandConstant('{commonappdata}') + '\Autodesk\Revit\Addins\' + Year + '\ProjectPerseus_' + Year + '.addin');
end;

// Ticks the Revit versions found on this PC (or already carrying Perseus) and labels each line
// "(installed)" / "(not found on this PC)". Nothing found at all = tick everything. An explicit
// /COMPONENTS= on the command line wins.
procedure PreselectRevitVersions;
var
  Rest, Year, Selection: String;
  P, Index, Found: Integer;
  Present: Boolean;
begin
  Rest := BuiltYears;
  Selection := '';
  Found := 0;
  Index := 0;
  while Rest <> '' do
  begin
    P := Pos(',', Rest);
    Year := Copy(Rest, 1, P - 1);
    Delete(Rest, 1, P);
    Present := RevitInstalled(Year) or PerseusInstalled(Year);
    if Present then
    begin
      Selection := Selection + 'revit' + Year + ',';
      Found := Found + 1;
    end else
      Selection := Selection + '!revit' + Year + ',';
    if RevitInstalled(Year) then
      WizardForm.ComponentsList.ItemCaption[Index] := 'Revit ' + Year + '   (installed)'
    else
      WizardForm.ComponentsList.ItemCaption[Index] := 'Revit ' + Year + '   (not found on this PC)';
    Index := Index + 1;
  end;
  if ExpandConstant('{param:COMPONENTS|}') <> '' then
    Exit;
  if Found = 0 then
    StringChangeEx(Selection, '!', '', True);
  WizardSelectComponents(Selection);
end;

// 1. THIS RUNS WHEN THE INSTALLER STARTS
procedure InitializeWizard;
var
  DefaultUrl: String;
begin
  WizardForm.SelectComponentsLabel.Caption :=
    'Choose the Revit versions to install Project Perseus into. Versions found on this PC are ticked. ' +
    'Unticking a version that already has Perseus removes it from that version.';
  PreselectRevitVersions;

  // Create a custom wizard page right after the "Select Destination" page
  ServerUrlPage := CreateInputQueryPage(wpSelectDir,
    'Server Configuration',
    'Where should Project Perseus connect?',
    'Please specify the Base URL for your Perseus server.');

  // Add the text input box
  ServerUrlPage.Add('Server Base URL:', False);

  // Read the command line parameter (e.g., /SERVERURL="https://sync.cox.com")
  // If the parameter doesn't exist, it falls back to the default URL provided after the pipe (|)
  DefaultUrl := ExpandConstant('{param:SERVERURL|https://labs.cox.com.au/perseus}');

  // Pre-fill the text box with the result
  ServerUrlPage.Values[0] := DefaultUrl;
end;

// At least one Revit version must be ticked.
function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if (CurPageID = wpSelectComponents) and (WizardSelectedComponents(False) = '') then
  begin
    MsgBox('Tick at least one Revit version.', mbError, MB_OK);
    Result := False;
  end;
end;

// 2. THIS RUNS RIGHT AFTER THE FILES ARE COPIED
procedure CurStepChanged(CurStep: TSetupStep);
var
  ConfigDir: String;
  ConfigFile: String;
  JsonContent: String;
begin
  // We only want to write the config file at the very end of the installation
  if CurStep = ssPostInstall then
  begin
    // Grab whatever value was in the text box (whether typed manually or injected via CLI)
    FinalServerUrl := ServerUrlPage.Values[0];

    // --- DEFINE WHERE YOUR C# CONFIG FILE LIVES ---
    // {userappdata} resolves to C:\Users\Username\AppData\Roaming
    ConfigDir := ExpandConstant('{userappdata}\Project Perseus');
    ConfigFile := ConfigDir + '\config.json';

    // Create the folder if it doesn't exist yet
    if not DirExists(ConfigDir) then
      CreateDir(ConfigDir);

    // Build the JSON string to match what your C# Config.Instance expects
    // Note: Pascal uses #13#10 for line breaks
    JsonContent := '{' + #13#10 +
                   '  "BaseUrl": "' + FinalServerUrl + '"' + #13#10 +
                   '}';

    // Save the text to the config.json file (False = overwrite, do not append)
    SaveStringToFile(ConfigFile, JsonContent, False);
  end;
end;
