[Setup]
ArchitecturesInstallIn64BitMode=x64
; --- 1. App Information ---
AppName=Project Perseus
AppVersion=1.1.81
AppId={{10908502-7BB8-473D-B858-B31591187295}}
DefaultGroupName=Andrew Butler

; --- 2. Installation Paths ---
DefaultDirName={autopf}\Project Perseus

; --- 3. Installer Output ---
OutputBaseFilename=Install_ProjectPerseus
Compression=lzma
SolidCompression=yes

; --- 4. The IT Requirement ---
PrivilegesRequired=admin 

; --- 5. App Lifecycle Rules ---
; Warns the user if Revit is open and locking the DLLs
CloseApplications=yes
; Prevents the installer from trying to auto-reboot Revit after installing
RestartApplications=no
; Optional: Adds your plugin icon to the Windows Add/Remove Programs list
; UninstallDisplayIcon={app}\2026\reset.png
