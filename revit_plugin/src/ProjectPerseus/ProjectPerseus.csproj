    <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == ''">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
  </PropertyGroup>

  <!-- BumpVersion must run BEFORE Build so CoreCompile bakes the new AssemblyVersion
       into the DLL. Previously it ran AfterTargets="Build" which produced installers
       containing a DLL stamped one version behind the installer/commit message. -->
  <Target Name="BumpVersion" BeforeTargets="Build" Condition="'$(SkipBumpVersion)' != 'true'">
    <Exec Command="powershell -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\..\..\bump-version.ps1&quot;" />
  </Target>

  <Target Name="BuildInstaller" AfterTargets="Build"
          DependsOnTargets="BuildOtherYears"
          Condition="'$(IsMultiYearSubBuild)' != 'true'">
    <Exec Command="&quot;$(InnoSetupCompiler)&quot; &quot;$(ProjectDir)..\..\installer\perseus_installer.iss&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- GitCommit lives in ProjectPerseusTests.csproj (the last project to build in the
       solution because it references ProjectPerseus). That way commit + push only run
       once the entire solution — including tests — has compiled successfully. -->

  <!-- ── Dev debug workflow ──────────────────────────────────────────────────────────
       KillRevit  : kills the running Revit process before build (avoids DLL lock)
       DevInstall : writes an .addin manifest pointing straight at the build output
                    so Revit loads the DLL in-place — no copy step needed.
       Both targets are gated on Debug configs that carry a year suffix (2023–2026).
       Release and plain Debug builds are unaffected.
  ───────────────────────────────────────────────────────────────────────────────── -->
  <PropertyGroup>
    <RevitVersion Condition="$(Configuration.Contains('2023'))">2023</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2024'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2025'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('2026'))">2026</RevitVersion>
  </PropertyGroup>

  <Target Name="KillRevit" BeforeTargets="Build" Condition="'$(RevitVersion)' != ''">
    <Exec Command="taskkill /f /im Revit.exe"       ContinueOnError="WarnAndContinue" />
    <Exec Command="taskkill /f /im RevitWorker.exe"  ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="DevInstall" AfterTargets="Build" Condition="'$(RevitVersion)' != ''">
    <Exec Command="powershell -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)dev-install.ps1&quot; -TargetPath &quot;$(TargetPath)&quot; -RevitVersion &quot;$(RevitVersion)&quot;" />
  </Target>

  <!-- ── Multi-year build ───────────────────────────────────────────────────────────────
       When building any year config (2023/2026) from VS, this target compiles all other
       viable years as sequential sub-builds so the installer always has both DLLs ready.
       IsMultiYearSubBuild=true prevents the sub-builds from chaining further.
       SkipBumpVersion=true prevents double-bumping the version number.
       BuildInstaller depends on this target so it waits until all DLLs exist.
  ─────────────────────────────────────────────────────────────────────────────────────── -->
  <Target Name="BuildOtherYears" AfterTargets="Build"
          Condition="'$(RevitVersion)' != '' AND '$(IsMultiYearSubBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFile)"
             Properties="Configuration=Debug 2023;Platform=x64;IsMultiYearSubBuild=true;SkipBumpVersion=true"
             Condition="'$(RevitVersion)' != '2023'" />
    <MSBuild Projects="$(MSBuildProjectFile)"
             Properties="Configuration=Debug 2026;Platform=x64;IsMultiYearSubBuild=true;SkipBumpVersion=true"
             Condition="'$(RevitVersion)' != '2026'" />
  </Target>

</Project>